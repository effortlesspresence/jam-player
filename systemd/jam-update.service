[Unit]
Description=JAM Player Update Service - Checks for and installs updates on boot
Documentation=https://github.com/anthropics/jam-player

# Run early in boot, after network is available and clock is synced
# time-sync.target ensures NTP has synced (critical for SSL certificate validation)
After=network-online.target time-sync.target
Wants=network-online.target time-sync.target

# Run after first boot completes (credentials must exist for error reporting)
After=jam-first-boot.service

# Run BEFORE other JAM services so they get the updated code.
#
# Display is intentionally NOT included here -- display should start
# immediately without waiting for updates so the customer never sees
# the bare desktop.
#
# BLE state manager + BLE provisioning are also intentionally NOT
# included. They used to be, but on a fresh first boot that meant a
# ~70-90s customer-visible delay before the JP appeared in the mobile
# app's BLE scan list (jam-update's first-install pipeline ran while
# BLE was held back). The pip-install race that originally motivated
# the ordering is now handled by BLE's Restart= + StartLimitBurst=30
# policy -- see the historical note in jam-ble-provisioning.service
# for context. Net effect: BLE is live within ~25s on a fresh boot
# instead of ~90s.
Before=jam-boot-check.service
Before=jam-content-manager.service
Before=jam-heartbeat.service
Before=jam-health-monitor.service
Before=jam-chrony-peering.service

[Service]
Type=oneshot

# Run as root - needs to install system-wide updates
User=root
Group=root

# Working directory
WorkingDirectory=/opt/jam/services

# Main script - checks for updates, installs if available, then exits
ExecStart=/opt/jam/venv/bin/python /opt/jam/services/jam_update.py

# Don't restart - this is a one-shot service that runs on boot
Restart=no

# Sized ABOVE the script's worst-case internal budget so systemd never
# SIGTERMs an update mid-flight (which bypasses fail_update/rollback entirely
# and can kill the process inside a file-copy). Budget (see the coupling
# comment at PIP_SUBPROCESS_TIMEOUT in jam_update.py):
#   git pull w/ retries      ~1650s
#   pip: 2 calls x (2 x 1200s + backoff)  ~4810s
#   venv verify x2            ~120s
#   services/units/configs    ~300s
#   ------------------------------
#   worst case               ~6880s
#   (+ ~1650s one-time when jam_update.py itself changed: the re-exec'd new
#    process repeats the git-fetch phase -> ~8530s true worst case)
# 9000s covers the re-exec worst case with ~8min margin. Every subprocess inside jam_update.py carries
# its own timeout, so the run is internally bounded well below this ceiling;
# this is a backstop, not the working limit. Change the pip constants ->
# re-check this number.
#
# TRANSITION NOTE: a fielded device's FIRST update through this code still
# runs under the OLD unit's 900s ceiling (the new unit file only governs
# later runs -- a daemon-reload mid-run does not extend the running job).
# That kill is survivable by design: all file operations are atomic
# (safe_copy/copy-over), the venv self-heal is installed and enabled BEFORE
# the dependency phase, and the pip cache resumes across boots.
TimeoutStartSec=9000

# Environment
Environment=PYTHONUNBUFFERED=1

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=jam-update

[Install]
WantedBy=multi-user.target
