[Unit]
Description=JAM Player BLE Provisioning - WiFi setup via Bluetooth
Documentation=https://github.com/anthropics/jam-player

# Wait for Bluetooth to be ready
After=bluetooth.target
Requires=bluetooth.target

# Wait for first boot to complete (credentials generated)
After=jam-first-boot.service

# Historical note: we used to gate this service on jam-update.service
# completion (`After=jam-update.service` plus a matching `Before=` in
# jam-update's unit) because jam-update's pip-install step rewrites
# /opt/jam/venv/, and if BLE imports happen mid-write they fail with
# ModuleNotFoundError. On a fresh first boot that gate added ~70-90s
# of customer-visible delay before the JP appeared in the mobile app's
# BLE scan list -- jam-update's full first-install pipeline ran while
# BLE was blocked.
#
# That gate has been removed in favor of letting systemd's Restart=
# policy ride out the pip-install window: BLE starts as soon as
# bluetooth.target + jam-first-boot are ready, attempts to import its
# Python modules, and if pip is mid-write it crashes with ImportError.
# Restart=on-failure + RestartSec=5 retries every 5 seconds. With
# StartLimitBurst=30 + StartLimitIntervalSec=300 we get ~150s of retry
# runway, more than enough to outlast any realistic pip-install. Once
# pip is done, the next retry succeeds immediately. Net result: BLE
# is live within ~25s on a fresh boot (vs ~90s before), with no
# permanent-failure risk because the burst limit is comfortably above
# the expected retry count.

# NOTE: We do NOT wait for jam-boot-check.service here!
# BLE provisioning must start ASAP on fresh devices so users can configure WiFi.
# Boot check waits for network, but BLE is how users SET UP the network.

# Restart limits (in Unit section for older systemd versions).
# StartLimitBurst raised from 5 to 30 specifically to give us 150s of
# retry runway during fresh-boot pip-install. See the historical note
# above for context.
StartLimitIntervalSec=300
StartLimitBurst=30

[Service]
Type=notify
ExecStart=/opt/jam/venv/bin/python /opt/jam/services/jam_ble_provisioning.py

# Run as root (needed for Bluetooth/D-Bus access)
User=root

# Restart on failure with backoff
Restart=on-failure
RestartSec=5

# systemd watchdog - service must ping every 90s or it gets restarted
# (Service pings every 30s, so 90s gives 3 chances)
WatchdogSec=90

# Environment
Environment=PYTHONUNBUFFERED=1

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=jam-ble-provisioning

[Install]
WantedBy=multi-user.target
